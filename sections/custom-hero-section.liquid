{% comment %}
  Custom Hero Section - With External CSS File
{% endcomment %}

{{ 'custom-hero-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .banner-wrapper {
    background-color: {{ section.settings.section_bg_color }};
  }

  #shopify-section-{{ section.id }} .banner-heading {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .banner-subheading {
    font-size: {{ section.settings.sub_heading_size }}px;
    color: {{ section.settings.sub_heading_color }};
  }

  #shopify-section-{{ section.id }} .banner-button {
    font-size: {{ section.settings.button_text_size }}px;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_bg_color }};
    border-color: {{ section.settings.button_bg_color }};
  }

  /* تحديد لون الخلفية المنزلقة من الـ Customizer */
  #shopify-section-{{ section.id }} .banner-button::before {
    background-color: {{ section.settings.button_hover_bg_color }};
  }

  /* تغيير لون النص والسهم عند الـ Hover */
  #shopify-section-{{ section.id }} .banner-button:hover {
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_bg_color }};
  }

  #shopify-section-{{ section.id }} .banner-button svg {
    stroke: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .banner-button:hover svg {
    stroke: {{ section.settings.button_hover_text_color }};
  }

  #shopify-section-{{ section.id }} .banner-image {
    border-radius: {{ section.settings.image_border_radius }}px;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}" class="banner-section">
  <div class="banner-wrapper">
    <div class="banner-container">
      <div class="banner-content">
        {% if section.settings.heading != blank %}
          <h1 class="banner-heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.sub_heading != blank %}
          <p class="banner-subheading">{{ section.settings.sub_heading }}</p>
        {% endif %}

{% if section.settings.button_text != blank and section.settings.button_url != blank %}
  <a href="{{ section.settings.button_url }}" class="banner-button">
    <span>{{ section.settings.button_text }}</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
{% endif %}
      </div>

      <div class="banner-image-wrapper">
        {% if section.settings.banner_image != blank %}
          <img 
            src="{{ section.settings.banner_image | image_url: width: 800 }}" 
            alt="{{ section.settings.heading }}"
            class="banner-image"
            loading="lazy"
          />
        {% else %}
          <div style="width: 100%; aspect-ratio: 1; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">
            <p>Image placeholder</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Welcome to Our Store"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },

    {
      "type": "header",
      "content": "Sub-Heading Settings"
    },
    {
      "type": "textarea",
      "id": "sub_heading",
      "label": "Sub-Heading",
      "default": "Discover amazing products"
    },
    {
      "type": "color",
      "id": "sub_heading_color",
      "label": "Sub-Heading Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "sub_heading_size",
      "label": "Sub-Heading Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button Text Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Button Hover Animation"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover Text Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Section"
    }
  ]
}
{% endschema %}