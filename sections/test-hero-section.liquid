{{ 'test-navbar-section.css' | asset_url | stylesheet_tag }}
{{ 'test-hero-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
/* Desktop Background */
#shopify-section-{{ section.id }} .hero-main-wrapper {
  {% if section.settings.hero_bg_image != blank %}
    background-image: url("{{ section.settings.hero_bg_image | image_url: width: 2000 }}");
  {% else %}
    background-image: url("{{ 'bannerImg.png' | asset_url }}");
  {% endif %}
}

/* Mobile Image Styling */
#shopify-section-{{ section.id }} .hero-mobile-img {
  {% if section.settings.hero_bg_image != blank %}
    background-image: url("{{ section.settings.hero_bg_image | image_url: width: 1000 }}");
  {% else %}
    background-image: url("{{ 'bannerImg.png' | asset_url }}");
  {% endif %}
}

#shopify-section-{{ section.id }} .title {
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.store_title_color }};
}
#shopify-section-{{ section.id }} .slogan {
    font-size: {{ section.settings.slogan_font_size }}px;
    color: {{ section.settings.store_slogan_color }};
}
#shopify-section-{{ section.id }} .nav-button {
    font-size: {{ section.settings.nav_button_text_size }}px;
    color: {{ section.settings.nav_button_text_color }};
    background-color: {{ section.settings.nav_button_bg_color }};
    border-color: {{ section.settings.nav_button_bg_color }};
}
#shopify-section-{{ section.id }} .nav-button::before {
    background-color: {{ section.settings.nav_button_hover_bg_color }};
}
#shopify-section-{{ section.id }} .nav-button:hover {
    color: {{ section.settings.nav_button_hover_text_color }};
    border-color: {{ section.settings.nav_button_hover_bg_color }};
}
#shopify-section-{{ section.id }} .nav-button svg {
    stroke: {{ section.settings.nav_button_text_color }};
}
#shopify-section-{{ section.id }} .nav-button:hover svg {
    stroke: {{ section.settings.nav_button_hover_text_color }};
}
#shopify-section-{{ section.id }} .header-text {
    font-size: {{ section.settings.hero_heading_font_size }}px;
    color: {{ section.settings.hero_heading_color }};
}
#shopify-section-{{ section.id }} .sub-header-text {
    font-size: {{ section.settings.hero_sub_heading_font_size }}px;
    color: {{ section.settings.hero_sub_heading_color }};
}
#shopify-section-{{ section.id }} .shop-now-button {
    font-size: {{ section.settings.button_text_size }}px;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_bg_color }};
    border-color: {{ section.settings.button_bg_color }};
}
#shopify-section-{{ section.id }} .shop-now-button::before {
    background-color: {{ section.settings.button_hover_bg_color }};
}
#shopify-section-{{ section.id }} .shop-now-button:hover {
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_bg_color }};
}
#shopify-section-{{ section.id }} .shop-now-button svg {
    stroke: {{ section.settings.button_text_color }};
}
#shopify-section-{{ section.id }} .shop-now-button:hover svg {
    stroke: {{ section.settings.button_hover_text_color }};
}
#shopify-section-{{ section.id }} .footer-text {
    font-size: {{ section.settings.footer_font_size }}px;
    color: {{ section.settings.footer_color }};
}
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}" class="banner-section">
    <!-- Navbar -->
    <nav class="navbar">
        <button class="toggle-btn" aria-label="Toggle Navigation" aria-expanded="false">
            <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="12" viewBox="0 0 20 12" fill="none">
              <path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M1 13.9994L13.7279 1.2715" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M1 1L13.7279 13.7279" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
          
        <h1 class="title">{{ section.settings.store_title }}</h1>
        <p class="slogan">{{ section.settings.store_slogan }}</p>
        <a href="{{ section.settings.nav_button_url }}" class="nav-button">
            <span>{{ section.settings.nav_button_text }}</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
    </nav>
    
    <!-- Desktop Hero View -->
    <div class="hero-main-wrapper desktop-only">
        <div class="banner-heading">
            <h1 class="header-text">{{ section.settings.hero_heading }}</h1>
            <p class="sub-header-text">{{ section.settings.hero_sub_heading }}</p>
            <a href="{{ section.settings.button_url }}" class="shop-now-button">
                <span>{{ section.settings.button_text }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>

    <!-- Mobile Hero View -->
    <div class="hero-mobile-wrapper mobile-only">
        <div class="mobile-text-content">
            <h1 class="header-text">{{ section.settings.hero_heading }}</h1>
            <p class="sub-header-text">{{ section.settings.hero_sub_heading }}</p>
        </div>
        <div class="hero-mobile-img">
            <a href="{{ section.settings.button_url }}" class="shop-now-button">
                <span>{{ section.settings.button_text }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>

    <!-- Footer Bar -->
    <div class="banner-footer">
        <p class="footer-text">{{ section.settings.footer_text }}</p>
    </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    const toggleBtn = section ? section.querySelector('.toggle-btn') : null;
    const navbar = section ? section.querySelector('.navbar') : null;

    if (toggleBtn && navbar) {
      toggleBtn.addEventListener('click', function() {
        const isActive = this.classList.toggle('is-active');
        navbar.classList.toggle('menu-open');
        this.setAttribute('aria-expanded', isActive);
      });
    }
  });
</script>

